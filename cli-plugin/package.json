{
  "name": "@realm-doctor/b2c-plugin-audit",
  "version": "0.2.0",
  "description": "B2C CLI plugin: read-only audit commands for Salesforce Commerce Cloud realms (errors, quota, code, Hyperforce, promotions, frontend).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"test/e2e/**\"",
    "test:e2e": "npm run build && vitest run test/e2e"
  },
  "oclif": {
    "bin": "realm-doctor",
    "dirname": "realm-doctor",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "audit": {
        "description": "Read-only audits of a B2C Commerce instance (realm-doctor)"
      }
    }
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@oclif/core": "^4",
    "@salesforce/b2c-tooling-sdk": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsonschema": "^1.5.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "bin": {
    "realm-doctor": "bin/run.js"
  }
}

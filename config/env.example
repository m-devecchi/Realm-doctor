# Local environment for realm-doctor. Copied to .env (git-ignored) by npm install.
# Read by the b2c CLI, realm-doctor and the MCP server when run from this folder.

# Do not send usage telemetry to Salesforce
SFCC_DISABLE_TELEMETRY=true

# Optional: client secret, if you prefer it here instead of "client-secret" in dw.json
# (only works when all instances share the same API client)
# SFCC_CLIENT_SECRET=
